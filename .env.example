# Voz Selling — variáveis de ambiente
# Nunca commitar valores reais. Peça as chaves ao responsável pelo projeto.

# --- IA (obrigatório para os agentes: análise, conversa, retomada) ---
OPENAI_API_KEY=
A1_MODEL=gpt-4o-mini
A3_MODEL=gpt-4o-mini
# Alternativos (opcional — a troca de provedor é só variável de ambiente, ver src/lib/llm.ts)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Instagram / Meta (obrigatório para conectar contas e falar com leads) ---
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
IG_WEBHOOK_VERIFY_TOKEN=

# --- Apify (opcional local — só o módulo Dream Pickup / raspagem do Ranking) ---
APIFY_TOKEN=

# --- Banco (obrigatório em qualquer deploy serverless — Vercel) ---
# Sem TURSO_DATABASE_URL, o banco vira um arquivo local (./data/dreamrobot.db,
# ou /tmp na Vercel) — e /tmp não sobrevive entre instâncias diferentes da
# função, o que quebra login e qualquer escrita de forma intermitente. Crie
# um banco grátis em turso.tech e cole os dois valores abaixo.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Só usado quando TURSO_DATABASE_URL não está definido (dev local).
DB_PATH=

# --- App ---
CRON_SECRET=troque-isto-localmente
SESSION_SECRET=troque-isto-localmente
